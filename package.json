{
  "name": "cv-builder-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-static.mjs",
    "boundary": "node scripts/check-public-boundary.mjs package.json",
    "security:check": "node scripts/security-check.mjs scan",
    "security:self-test": "node scripts/security-check.mjs self-test",
    "test": "vitest run",
    "qa:static-flow": "node scripts/static-flow-qa.mjs",
    "qa:static-pdf": "node scripts/static-pdf-qa.mjs",
    "qa:static": "node scripts/serve-and-qa.mjs",
    "lint": "eslint .",
    "format": "prettier --check package.json package-lock.json tsconfig.json next.config.mjs vitest.config.ts eslint.config.mjs prettier.config.mjs \".github/**/*.{yml,yaml}\" \"packages/**/*.{json,mjs,ts,tsx,css}\" \"scripts/**/*.mjs\" \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run boundary && npm run typecheck && npm test && npm run lint && npm run format && npm run build && npm run security:check"
  },
  "dependencies": {
    "@cv-builder/pdf-templates": "1.0.0",
    "@cv-builder/resume-core": "1.0.0",
    "next": "^16.3.4",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.4",
    "playwright": "1.63.0",
    "prettier": "3.8.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "sharp": "^0.35.4"
  }
}
